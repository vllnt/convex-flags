{
  "name": "@vllnt/convex-flags",
  "version": "0.1.1",
  "description": "Feature flags as a Convex component — variants, targeting, percentage rollouts, and per-subject overrides, evaluated on the backend and streamed live to clients.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js",
  "scripts": {
    "build": "tsc --project ./tsconfig.build.json",
    "build:codegen": "pnpm codegen && pnpm build",
    "build:clean": "rm -rf dist *.tsbuildinfo && pnpm build:codegen",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "tsc --noEmit --project tsconfig.ci.json",
    "lint": "pnpm check:agents && eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "preversion": "pnpm install --frozen-lockfile && pnpm build && pnpm test:coverage && pnpm typecheck",
    "check:agents": "node -e \"const f=require('node:fs');if(!f.existsSync('AGENTS.md')||f.existsSync('CLAUDE.md')||f.existsSync('.claude'))process.exit(1)\"",
    "codegen": "pnpm convex codegen --component-dir ./src/component"
  },
  "peerDependencies": {
    "convex": "^1.45.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vllnt/eslint-config": "2.0.0",
    "@vllnt/typescript": "2.0.0",
    "convex": "^1.48.0",
    "convex-test": "^0.0.65",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "minimumReleaseAge": 10080,
    "minimumReleaseAgeExclude": [
      "@vllnt/*"
    ],
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "deepmerge-ts@<8.0.0": "8.0.0",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "handlebars@<4.7.10": "4.7.10"
    }
  },
  "homepage": "https://github.com/vllnt/convex-flags#readme",
  "bugs": {
    "url": "https://github.com/vllnt/convex-flags/issues"
  },
  "author": {
    "name": "bntvllnt",
    "url": "https://bntvllnt.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/bntvllnt"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vllnt/convex-flags"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "convex",
    "convex-component",
    "flags"
  ]
}
