{
  "name": "@vllnt/convex-flags",
  "version": "0.1.1",
  "description": "Convex component for feature flags in TypeScript: kill switches, variants, attribute targeting, percentage rollouts, per-subject overrides and React hooks.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "files": [
    "dist",
    "src",
    "docs/API.md",
    "CHANGELOG.md",
    "llms.txt",
    "!src/**/*.test.*",
    "!src/**/*.spec.*"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js",
  "scripts": {
    "build": "tsc --project ./tsconfig.build.json",
    "build:codegen": "pnpm codegen && pnpm build",
    "build:clean": "rm -rf dist *.tsbuildinfo && pnpm build:codegen",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "typecheck:ci": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck-ci.tsbuildinfo --project tsconfig.ci.json",
    "typecheck:test": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck-test.tsbuildinfo --project tsconfig.test.json",
    "lint": "pnpm check:agents && eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "preversion": "pnpm install --frozen-lockfile && pnpm build && pnpm test:coverage && pnpm typecheck",
    "test:package": "node scripts/test-package.mjs",
    "check:agents": "node -e \"const f=require('node:fs');if(!f.existsSync('AGENTS.md')||f.existsSync('CLAUDE.md')||f.existsSync('.claude'))process.exit(1)\"",
    "codegen": "pnpm convex codegen --component-dir ./src/component"
  },
  "peerDependencies": {
    "convex": "^1.45.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.1.1",
    "@vllnt/eslint-config": "2.1.0",
    "@vllnt/typescript": "3.0.0",
    "convex": "^1.51.0",
    "convex-test": "^0.0.73",
    "eslint": "^9.39.5",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "minimumReleaseAge": 10080,
    "minimumReleaseAgeExclude": [
      "@vllnt/*"
    ],
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": "11.0.5",
      "deepmerge-ts@<8.0.0": "8.0.0",
      "handlebars@<4.7.10": "4.7.10"
    }
  },
  "homepage": "https://oss.vllnt.com/packages/convex-flags",
  "bugs": {
    "url": "https://github.com/vllnt/convex-flags/issues"
  },
  "author": {
    "name": "bntvllnt",
    "url": "https://bntvllnt.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/bntvllnt"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vllnt/convex-flags"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "convex",
    "convex-component",
    "typescript",
    "react",
    "feature-flags",
    "feature-toggles",
    "kill-switch",
    "rollout",
    "percentage-rollout",
    "targeting",
    "variants"
  ]
}
